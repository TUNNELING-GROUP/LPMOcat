# Copy to .env (next to docker-compose.yml) and fill in. .env is not in git: it holds the
# production secret key.

# A long random string, e.g. from:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=False

# Host names (and IP addresses, if the site is reached by them) the site answers to
DJANGO_ALLOWED_HOSTS=example.org,www.example.org,localhost,127.0.0.1

# Origins allowed to submit forms (scheme included); the https ones matter once the site is
# served over https
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.org,https://www.example.org,http://localhost,http://127.0.0.1

# Leave these off while the proxy in front serves plain http; turn on once https works
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Behind the server's reverse proxy
DJANGO_USE_X_FORWARDED_HOST=True
# "none" while the site is served over plain http (the header only works on https)
DJANGO_SECURE_CROSS_ORIGIN_OPENER_POLICY=none

# Host port the container listens on (127.0.0.1 only); the proxy forwards to it
LPMOCAT_PORT=8000
